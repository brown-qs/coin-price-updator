# Pyth Hermes (default base; path is /v2/updates/price/latest)
PYTH_HERMES_BASE=https://hermes.pyth.network
# Required for public Hermes: default Python urllib User-Agent gets HTTP 403
# PYTH_HTTP_USER_AGENT=coin-price-updator/1.0 (+https://docs.pyth.network/)

# ClickHouse (HTTP 8123 or native 9000 with CLICKHOUSE_INTERFACE=native)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=bbb
# Table name within that database (rows: updated_at, key, value)
# CLICKHOUSE_SYSTEM_TABLE=system
# CLICKHOUSE_INTERFACE=http

POLL_INTERVAL_SEC=60

# After each poll, OPTIMIZE TABLE ... FINAL so ReplacingMergeTree keeps one part per key (set 0 to skip)
# CLICKHOUSE_OPTIMIZE_FINAL=1
